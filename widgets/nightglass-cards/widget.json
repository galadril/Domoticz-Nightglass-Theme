{
    "name": "Nightglass Cards",
    "description": "The compact device card from the Nightglass tour, as a dashboard widget",
    "author": "galadril",
    "version": "1.0.0",
    "apiVersion": 1,
    "widgets": [
        {
            "type": "ng-device-card",
            "label": "Device Card",
            "description": "Compact switch card with the tour's lit icon frame — tap to toggle",
            "category": "Devices",
            "icon": "fa-solid fa-lightbulb",
            "entry": "ngDeviceCard.widget.js",
            "template": "ngDeviceCard.html",
            "css": "ngDeviceCard.css",
            "defaultW": 2,
            "defaultH": 2,
            "minW": 1,
            "minH": 1,
            "maxW": 6,
            "maxH": 4,
            "configSchema": [
                { "key": "deviceIdx", "type": "device-picker", "label": "Device", "required": true },
                { "key": "title", "type": "text", "label": "Name override (optional)", "required": false },
                { "key": "icon", "type": "text", "label": "Icon override (Font Awesome classes)", "required": false,
                  "help": "For example: fa-solid fa-fan. Left empty, the icon follows the device type." },
                { "key": "tint", "type": "color", "label": "Lit colour", "default": "#4e9af1" },
                { "key": "showFooter", "type": "boolean", "label": "Show last-updated time", "default": true },
                { "key": "allowToggle", "type": "boolean", "label": "Tap the card to toggle", "default": true }
            ]
        }
    ]
}
